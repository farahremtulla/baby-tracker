rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The 6-character family code IS the document ID. Knowing the code is
    // what grants access (like a shared Wi-Fi password) — there are no
    // individual user accounts. Anonymous auth just stops totally random,
    // unauthenticated bots from hitting the database.
    match /families/{code} {
      allow get: if request.auth != null;
      allow list: if false; // can't browse/enumerate all families
      allow create: if request.auth != null;
      allow update: if request.auth != null;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/families/$(code)).data.memberUids.hasAny([request.auth.uid]);
      }
    }
  }
}
